[Unit]
Description=Public dataviz repair website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/karthik/apps/karthik-data-visualization-skill
EnvironmentFile=/home/karthik/.hermes/.env
Environment=DATAVIZ_PUBLIC_ROOT=/home/karthik/.local/share/dataviz-public
Environment=DATAVIZ_SECURE_COOKIE=1
Environment=DATAVIZ_DAILY_CASE_LIMIT=50
Environment=DATAVIZ_DAILY_IP_LIMIT=3
Environment=DATAVIZ_REASONING_EFFORT=medium
ExecStart=/home/karthik/apps/karthik-data-visualization-skill/.venv/bin/python -m uvicorn public_site.app:app --host 127.0.0.1 --port 8790 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/karthik/.local/share/dataviz-public
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=default.target
